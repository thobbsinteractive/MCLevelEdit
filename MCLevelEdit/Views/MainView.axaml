<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MCLevelEdit.ViewModels;assembly=MCLevelEdit"
             xmlns:views="clr-namespace:MCLevelEdit.Views"
             xmlns:domain="clr-namespace:MCLevelEdit.Model.Domain;assembly=MCLevelEdit.Model"
             xmlns:terrain="clr-namespace:MagicCarpet2Terrain.Model;assembly=MagicCarpet2Terrain"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="MCLevelEdit.Views.MainView"
             x:DataType="vm:MainViewModel">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Magic Carpet _1">
          <MenuItem Header="_New Blank" Command="{Binding NewFileCommand}" CommandParameter="{x:Static domain:GameVersion.MagicCarpet1}"/>
          <MenuItem Header="New _Random" Command="{Binding NewRandomFileCommand}" CommandParameter="{x:Static domain:GameVersion.MagicCarpet1}"/>
        </MenuItem>
        <MenuItem Header="Magic Carpet _Hidden Worlds">
          <MenuItem Header="_New Blank" Command="{Binding NewFileCommand}" CommandParameter="{x:Static domain:GameVersion.MagicCarpet1}"/>
          <MenuItem Header="New _Random" Command="{Binding NewRandomFileCommand}" CommandParameter="{x:Static domain:GameVersion.MagicCarpet1}"/>
        </MenuItem>
        <MenuItem Header="Magic Carpet _2">
          <MenuItem Header="_Day">
            <MenuItem Header="_New Blank" Command="{Binding NewMc2FileCommand}" CommandParameter="{x:Static terrain:MapType.Day}"/>
            <MenuItem Header="New _Random" Command="{Binding NewMc2RandomFileCommand}" CommandParameter="{x:Static terrain:MapType.Day}"/>
          </MenuItem>
          <MenuItem Header="_Night">
            <MenuItem Header="_New Blank" Command="{Binding NewMc2FileCommand}" CommandParameter="{x:Static terrain:MapType.Night}"/>
            <MenuItem Header="New _Random" Command="{Binding NewMc2RandomFileCommand}" CommandParameter="{x:Static terrain:MapType.Night}"/>
          </MenuItem>
          <!-- A blank cave has no terrain to build the cave from, so caves always start random -->
          <MenuItem Header="_Cave">
            <MenuItem Header="New _Random" Command="{Binding NewMc2RandomFileCommand}" CommandParameter="{x:Static terrain:MapType.Cave}"/>
          </MenuItem>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Open" Command="{Binding OpenFileCommand}"/>
        <MenuItem Header="_Save" Command="{Binding SaveFileCommand}"/>
        <MenuItem Header="Save _As" Command="{Binding SaveFileAsCommand}"/>
        <Separator/>
        <MenuItem Header="_Export Heightmap" Command="{Binding ExportHeightMapCommand}"/>
        <MenuItem Header="_Export Terrain Render" Command="{Binding ExportTerrainRenderCommand}"/>
        <Separator/>
        <MenuItem Header="_Exit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Reset View" Command="{Binding ResetViewCommand}"/>
        <MenuItem Header="Show _Connections" Command="{Binding ShowConnectionsCommand}"/>
        <Separator/>
        <MenuItem Header="Show _Shaded" Command="{Binding ShadedCommand}"/>
        <MenuItem Header="Show _Heightmap" Command="{Binding HeightMapCommand}"/>
      </MenuItem>
      <MenuItem Header="_Game">
        <MenuItem Header="_Game Settings" Command="{Binding EditGameSettingsCommand}"/>
        <Separator/>
        <MenuItem Header="_Unpack Levels" Command="{Binding UnpackLevelsCommand}"/>
        <MenuItem Header="_Package Levels" Command="{Binding PackageLevelsCommand}"/>
        <Separator/>
        <MenuItem Header="_Validate Level" Command="{Binding ValidateCommand}"/>
        <MenuItem Header="_Run Current Level" Command="{Binding RunCommand}"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Command="{Binding DisplayAboutCommand}"/>
        <MenuItem Header="_Manual" Command="{Binding ShowManualCommand}" />
      </MenuItem>
    </Menu>
    <Grid Name="grdMain"
          DockPanel.Dock="Bottom"
          ColumnDefinitions="*"
          RowDefinitions="*,50">
      <Grid Grid.Row="0"
            Grid.Column="0"
            ColumnDefinitions="256,*,300"
            RowDefinitions="100,*">
        <views:EntityToolBarView Name="vmEntityToolBar"
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="3"
                                 DockPanel.Dock="Top"
                                 DataContext="{Binding EntityToolBarViewModel}"/>
        <views:MapTreeView Name="vmMapTree"
                           Grid.Row="1"
                           Grid.Column="0"
                           DataContext="{Binding MapTreeViewModel}"/>
        <views:MapEditorView Name="vmMapEditor"
                             Grid.Row="1"
                             Grid.Column="1"
                             DataContext="{Binding MapEditorViewModel}"/>
        <views:NodePropertiesView Name="vmNodeProperties"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  DataContext="{Binding NodePropertiesViewModel}"/>
      </Grid>
      <Border HorizontalAlignment="Stretch"
              Grid.Row="1"
              Grid.Column="0"
              BorderBrush="LightGray"
              BorderThickness="0,1"
              Padding="5">
        <Grid RowDefinitions="40"
              ColumnDefinitions="150,*,150,150">
          <Button Name="btnFailures"
                  Grid.Column="2"
                  Height="38"
                  HorizontalAlignment="Right"
                  Command="{Binding DisplayFailCommand}">
            <StackPanel Orientation="Horizontal">
              <Image Source="/Assets/error-32.png"/>
              <Label Content="{Binding FailCount, StringFormat=' {0} Failure(s)'}" />
            </StackPanel>
          </Button>
          <Button Name="btnWarnings"
                  Grid.Column="3"
                  Height="38"
                  HorizontalAlignment="Right"
                  Command="{Binding DisplayWarningsCommand}">
            <StackPanel Orientation="Horizontal">
              <Image Source="/Assets/warning-32.png"/>
              <Label Content="{Binding WarningCount, StringFormat=' {0} Warning(s)'}" />
            </StackPanel>
          </Button>
          <Button Name="btnRun"
                  Grid.Column="0"
                  VerticalContentAlignment="Center"
                  HorizontalContentAlignment="Center"
                  Height="38"
                  MinWidth="150"
                  Command="{Binding RunCommand}">
              Run
          </Button>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>

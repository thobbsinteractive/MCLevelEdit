<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MCLevelEdit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="500"
             x:Class="MCLevelEdit.Views.PackageLevelsView"
             x:DataType="vm:PackageFilesViewModel">
  <Grid Name="gdPackage"
        Margin="10"
        ColumnDefinitions="150,*,120"
        RowDefinitions="40,40,40,*,40">
    <Button Name="btnAddFiles"
            Grid.Column="2"
            Grid.Row="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Content="Add Files"
            Command="{Binding SelectFilesCommand}"/>
    <Label Grid.Column="0"
           Grid.Row="1"
           Content="Files:"
           VerticalAlignment="Center"/>
    <ListBox Grid.Column="1"
             Grid.Row="1"
             VerticalAlignment="Center"
             HorizontalAlignment="Stretch"
             ItemsSource="{Binding FilesList}"/>
    <Label Grid.Column="0"
           Grid.Row="2"
           Content="Extraction Folder:"
           VerticalAlignment="Center"/>
    <TextBox Grid.Column="1"
             Grid.Row="2"
             VerticalAlignment="Center"
             HorizontalAlignment="Stretch"
             Text="{Binding OutputPath}"/>
    <Button Name="btnSelectOutputPath"
            Grid.Column="2"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Content="Select"
            Command="{Binding SelectOutputPathCommand}"/>
    <Grid Name="gdButtons"
          Grid.Column="2"
          Grid.Row="4"
          ColumnDefinitions="*"
          RowDefinitions="40">
      <Button Name="btnPackage"
              Grid.Column="0"
              Grid.Row="0"
              ToolTip.Tip="Will packages the selected files as Output path"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Content="Package Files"
              IsEnabled="{Binding CanPack}"
              Command="{Binding PackageCommand}"/>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="600"
             xmlns:c="clr-namespace:MCLevelEdit.Converter"
             xmlns:vm="clr-namespace:MCLevelEdit.ViewModels"
             xmlns:view="clr-namespace:MCLevelEdit.Views"
             x:Class="MCLevelEdit.Views.EditWizardView"
             x:DataType="vm:EditWizardViewModel">
  <Grid Margin="5"
        ColumnDefinitions="1*,1*"
        RowDefinitions="40,30,30,30,30,40,*">
    <Grid.Resources>
      <c:UInt8ToStringConverter x:Key="uInt8ToStringConverter"/>
      <c:Int16ToStringConverter x:Key="int16ToStringConverter"/>
    </Grid.Resources>
    <Label Grid.Column="0"
           Grid.Row="0"
           Grid.ColumnSpan="2"
           FontWeight="Bold"
           HorizontalAlignment="Left"
           VerticalAlignment="Center">
      Wizard Properties
    </Label>
    <Label Grid.Column="0"
           Grid.Row="1"
           HorizontalAlignment="Left">
      Agression:
    </Label>
    <TextBox Name="txtAgression"
             Grid.Column="1"
             Grid.Row="1"
             Text="{Binding Agression, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Label Grid.Column="0"
           Grid.Row="2"
           HorizontalAlignment="Left">
      Perception:
    </Label>
    <TextBox Name="txtPerception"
             Grid.Column="1"
             Grid.Row="2"
             Text="{Binding Perception, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Label Grid.Column="0"
       Grid.Row="3"
       HorizontalAlignment="Left">
      Reflexes:
    </Label>
    <TextBox Name="txtReflexes"
             Grid.Column="1"
             Grid.Row="3"
             Text="{Binding Reflexes, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Label Grid.Column="0"
       Grid.Row="4"
       IsVisible="{Binding IsMc1}"
       HorizontalAlignment="Left">
      Castle Level:
    </Label>
    <TextBox Name="txtCastleLevel"
             Grid.Column="1"
             Grid.Row="4"
             IsVisible="{Binding IsMc1}"
             Text="{Binding CastleLevel, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Label Grid.Column="0"
       Grid.Row="4"
       IsVisible="{Binding IsMc2}"
       HorizontalAlignment="Left">
      Life:
    </Label>
    <TextBox Name="txtLife"
             Grid.Column="1"
             Grid.Row="4"
             IsVisible="{Binding IsMc2}"
             Text="{Binding Life, Converter={StaticResource int16ToStringConverter}}">
    </TextBox>
    <Label Grid.Column="0"
           Grid.Row="5"
           Grid.ColumnSpan="2"
           FontWeight="Bold"
           HorizontalAlignment="Left"
           VerticalAlignment="Center">
      Wizard Spells
    </Label>
    <Panel Grid.Row="6"
           Grid.Column="0"
           Grid.ColumnSpan="2"
           IsVisible="{Binding IsMc1}">
      <view:EditSpells Name="esSpells"
                       HorizontalAlignment="Center"
                       DataContext="{Binding Spells}"/>
    </Panel>
    <!-- Magic Carpet 2: 26 spells, each with starting / level / blocked -->
    <Grid Grid.Row="6"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          RowDefinitions="Auto,*"
          IsVisible="{Binding IsMc2}">
      <Grid Grid.Row="0" ColumnDefinitions="*,40,40,40" Margin="0,0,0,2">
        <TextBlock Grid.Column="0" FontWeight="Bold" Text="Spell"/>
        <TextBlock Grid.Column="1" FontWeight="Bold" Text="Start" ToolTip.Tip="Wizard starts with this spell"/>
        <TextBlock Grid.Column="2" FontWeight="Bold" Text="Lvl" ToolTip.Tip="Spell level"/>
        <TextBlock Grid.Column="3" FontWeight="Bold" Text="Block" ToolTip.Tip="Wizard can never have this spell"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Mc2Spells}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Mc2SpellViewModel">
              <Grid ColumnDefinitions="*,40,40,40" Height="28">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Name}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding StartsWith}"/>
                <TextBox Grid.Column="2" MinWidth="0" Padding="2" VerticalAlignment="Center"
                         Text="{Binding Level, Converter={StaticResource uInt8ToStringConverter}}"/>
                <CheckBox Grid.Column="3" IsChecked="{Binding Blocked}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

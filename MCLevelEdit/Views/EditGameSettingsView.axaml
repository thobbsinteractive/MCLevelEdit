<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MCLevelEdit.ViewModels"
             xmlns:views="clr-namespace:MCLevelEdit.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="420"
             x:Class="MCLevelEdit.Views.EditGameSettingsView"
             x:DataType="vm:EditGameSettingsViewModel">
  <Grid Margin="10" RowDefinitions="40,*,40">
    <!-- The level(s) to run. Magic Carpet 2 HD runs only the first one -->
    <Grid Grid.Row="0"
          ColumnDefinitions="205,*,100">
      <Label Grid.Column="0"
             Content="Level File:"
             VerticalAlignment="Center"/>
      <Label Grid.Column="1"
             VerticalAlignment="Center"
             Content="{Binding LevelPathsString}"/>
      <Button Name="btnSelectLevels"
              Grid.Column="2"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Content="Select"
              Command="{Binding SelectLevelsCommand}"/>
    </Grid>
    <TabControl Name="tcGames"
                Grid.Row="1"
                SelectedIndex="{Binding SelectedGameTabIndex}">
      <TabItem Header="Magic Carpet">
        <views:DosGameSettingsView DataContext="{Binding MagicCarpet1}"/>
      </TabItem>
      <TabItem Header="Hidden Worlds">
        <views:DosGameSettingsView DataContext="{Binding HiddenWorlds}"/>
      </TabItem>
      <TabItem Header="Magic Carpet 2">
        <Grid Name="gdEditMc2Settings"
              ColumnDefinitions="205,*,100"
              RowDefinitions="40,*">
          <Label Grid.Column="0"
                 Grid.Row="0"
                 Content="Magic Carpet 2 HD:"
                 VerticalAlignment="Center"/>
          <TextBox Name="txtMc2ExeLocation"
                   Grid.Column="1"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   Text="{Binding Mc2ExePath}"/>
          <Button Name="btnSelectMc2ExeLocation"
                  Grid.Column="2"
                  Grid.Row="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Content="Select"
                  Command="{Binding SelectMc2ExeCommand}"/>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Name="gdButtons"
          Grid.Row="2"
          ColumnDefinitions="115,180,180,*,90"
          RowDefinitions="40">
      <Button Name="btnSave"
              Grid.Column="0"
              Grid.Row="0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              ToolTip.Tip="Save the current settings, including which game Run Level launches"
              Content="Save Settings"
              Command="{Binding SaveCommand}"/>
      <Button Name="btnBackup"
              Grid.Column="1"
              Grid.Row="0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              Width="175"
              ToolTip.Tip="Backup the original levels of the selected game"
              Content="Backup Original Levels"
              IsVisible="{Binding IsDosGame}"
              Command="{Binding BackupCommand}"/>
      <Button Name="btnRestore"
              Grid.Column="2"
              Grid.Row="0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              Width="175"
              ToolTip.Tip="Restore the original levels of the selected game from the backup"
              Content="Restore Original Levels"
              IsVisible="{Binding IsDosGame}"
              Command="{Binding RestoreCommand}"/>
      <Button Name="btnCheck"
              Grid.Column="3"
              Grid.Row="0"
              ToolTip.Tip="Will check that the paths exist (except the backup path, this only has to be set)"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Content="Check Paths"
              Command="{Binding CheckLevelCommand}"/>
      <Button Name="btnRun"
              Grid.Column="4"
              Grid.Row="0"
              ToolTip.Tip="Will check the paths, save the settings and run the game on the selected tab"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Content="Run Level"
              IsEnabled="{Binding CanRun}"
              Command="{Binding RunLevelCommand}"/>
    </Grid>
  </Grid>
</UserControl>

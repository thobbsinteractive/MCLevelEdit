<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MCLevelEdit.ViewModels"
             xmlns:views="clr-namespace:MCLevelEdit.Views"
             xmlns:c="clr-namespace:MCLevelEdit.Converter"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="MCLevelEdit.Views.EditWorldView"
             x:DataType="vm:EditWorldViewModel">
  <Grid Margin="5"
        ColumnDefinitions="3*,1*,2*,1*"
        RowDefinitions="40,Auto,30,30,40,40,30,30,30,30,30,30,30,30,30,30,30,Auto,Auto,40,*">
    <Grid.Resources>
      <c:UInt32ToStringConverter x:Key="uInt32ToStringConverter"/>
      <c:UInt16ToStringConverter x:Key="uInt16ToStringConverter"/>
      <c:UInt8ToStringConverter x:Key="uInt8ToStringConverter"/>
    </Grid.Resources>
    <Label Grid.Column="0"
           Grid.Row="0"
           Grid.ColumnSpan="4"
           FontWeight="Bold"
           HorizontalAlignment="Left"
           VerticalAlignment="Center">
      Level Properties
    </Label>
    <!-- Magic Carpet format levels: which game the level is for (the file can't say). Shares row 1 with MC2's Map Type -->
    <Label Grid.Column="0"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           IsVisible="{Binding IsMc1Format}">
      Game:
    </Label>
    <StackPanel Grid.Column="1"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Orientation="Vertical"
                Margin="0,0,0,5"
                ToolTip.Tip="Hidden Worlds levels use the Magic Carpet format, so the level file can't say which game it is for"
                IsVisible="{Binding IsMc1Format}">
      <RadioButton Content="Magic Carpet" IsChecked="{Binding IsMagicCarpetGame}"/>
      <RadioButton Content="Hidden Worlds" IsChecked="{Binding IsHiddenWorldsGame}"/>
    </StackPanel>

    <!-- Magic Carpet 2 only: the row is Auto height so it collapses for other levels -->
    <Label Grid.Column="0"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           IsVisible="{Binding IsMc2}">
      Map Type:
    </Label>
    <StackPanel Grid.Column="1"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Orientation="Vertical"
                Margin="0,0,0,5"
                IsVisible="{Binding IsMc2}">
      <RadioButton Content="Day" IsChecked="{Binding IsDay}"/>
      <RadioButton Content="Night" IsChecked="{Binding IsNight}"/>
      <RadioButton Content="Cave" IsChecked="{Binding IsCave}"/>
    </StackPanel>
    <Label Grid.Column="0"
           Grid.Row="2"
           HorizontalAlignment="Left">
      Mana Total:
    </Label>
    <TextBox Grid.Column="1"
             Grid.Row="2"
             Grid.ColumnSpan="2"
             HorizontalAlignment="Stretch"
             Text="{Binding ManaTotal, Converter={StaticResource uInt32ToStringConverter}}">
    </TextBox>
    <Label Grid.Column="0"
           Grid.Row="3"
           HorizontalAlignment="Left">
      Mana Target (%):
    </Label>
    <TextBox Grid.Column="1"
             Grid.Row="3"
             Grid.ColumnSpan="2"
             HorizontalAlignment="Stretch"
             Text="{Binding ManaTarget, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button x:Name="btnRecalc"
        Grid.Column="0"
        Grid.Row="4"
        HorizontalAlignment="Center"
        Grid.ColumnSpan="4"
        Command="{Binding CalculateManaCommand}"
        IsEnabled="">
      Recalculate Mana
    </Button>
    <Label Grid.Column="0"
       Grid.Row="5"
       Grid.ColumnSpan="4"
       FontWeight="Bold"
       HorizontalAlignment="Left"
       VerticalAlignment="Center">
      Terrain Generation Variables
    </Label>
    <Label Grid.Column="0"
           Grid.Row="6"
           HorizontalAlignment="Left">
      Seed:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="6"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseSeedCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="6"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.Seed, Converter={StaticResource uInt16ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="6"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseSeedCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="7"
           HorizontalAlignment="Left">
      Offset:
    </Label>
    <Button Grid.Column="1"
        Grid.Row="7"
        Content="-"
        HorizontalAlignment="Center"
        Command="{Binding DecreaseOffsetCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="7"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.Offset, Converter={StaticResource uInt16ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="7"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseOffsetCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="8"
           HorizontalAlignment="Left">
      Raise:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="8"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseRaiseCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="8"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.Raise, Converter={StaticResource uInt32ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="8"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseRaiseCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="9"
           HorizontalAlignment="Left">
      Gnarl:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="9"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseGnarlCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="9"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.Gnarl, Converter={StaticResource uInt16ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="9"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseGnarlCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="10"
           HorizontalAlignment="Left">
      River:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="10"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseRiverCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="10"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.River, Converter={StaticResource uInt16ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="10"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseRiverCommand}"/>

    <!-- The lowest height a river can start from (both games) -->
    <Label Grid.Column="0"
           Grid.Row="11"
           HorizontalAlignment="Left"
           ToolTip.Tip="The lowest height a river can start from">
      LRiver:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="11"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseLRiverCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="11"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.LRiver, Converter={StaticResource uInt16ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="11"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseLRiverCommand}"/>

    <Label Grid.Column="0"
           Grid.Row="12"
           HorizontalAlignment="Left">
      Source:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="12"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseSourceCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="12"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.Source, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="12"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseSourceCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="13"
           HorizontalAlignment="Left">
      SnLin:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="13"
            Content="-"
            HorizontalAlignment="Center"
            Command="{Binding DecreaseSnLinCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="13"
             HorizontalAlignment="Stretch"
             Text="{Binding GenerationParameters.SnLin, Converter={StaticResource uInt16ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="13"
            Content="+"
            HorizontalAlignment="Center"
            Command="{Binding IncreaseSnLinCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="14"
           HorizontalAlignment="Left">
      SnFlt:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="14"
            Content="-"
            HorizontalAlignment="Center"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding DecreaseSnFltCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="14"
             HorizontalAlignment="Stretch"
             IsEnabled="{Binding GenerateTerrainButtonEnable}"
             Text="{Binding GenerationParameters.SnFlt, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="14"
            Content="+"
            HorizontalAlignment="Center"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding IncreaseSnFltCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="15"
           HorizontalAlignment="Left">
      BhLin:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="15"
            Content="-"
            HorizontalAlignment="Center"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding DecreaseBhLinCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="15"
             HorizontalAlignment="Stretch"
             IsEnabled="{Binding GenerateTerrainButtonEnable}"
             Text="{Binding GenerationParameters.BhLin, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="15"
            Content="+"
            HorizontalAlignment="Center"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding IncreaseBhLinCommand}"/>
    
    <Label Grid.Column="0"
           Grid.Row="16"
           HorizontalAlignment="Left">
      Sand (BhFlt):
    </Label>
    <Button Grid.Column="1"
            Grid.Row="16"
            Content="-"
            HorizontalAlignment="Center"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding DecreaseSandCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="16"
             HorizontalAlignment="Stretch"
             IsEnabled="{Binding GenerateTerrainButtonEnable}"
             Text="{Binding GenerationParameters.BhFlt, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="16"
            Content="+"
            HorizontalAlignment="Center"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding IncreaseSandCommand}"/>
    
    <!-- Magic Carpet 2 only: MC1 levels have no RkSte. The row is Auto so it collapses otherwise -->
    <Label Grid.Column="0"
           Grid.Row="17"
           HorizontalAlignment="Left"
           IsVisible="{Binding IsMc2}">
      RkSte:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="17"
            Content="-"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsMc2}"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding DecreaseRkSteCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="17"
             Height="30"
             HorizontalAlignment="Stretch"
             IsVisible="{Binding IsMc2}"
             IsEnabled="{Binding GenerateTerrainButtonEnable}"
             Text="{Binding GenerationParameters.RkSte, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="17"
            Content="+"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsMc2}"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding IncreaseRkSteCommand}"/>

    <!-- Cave levels only: the roof height the cave ceiling is built down from. The row is Auto so it collapses otherwise -->
    <Label Grid.Column="0"
           Grid.Row="18"
           HorizontalAlignment="Left"
           ToolTip.Tip="The height of the cave roof. Ground at or above the roof becomes solid rock"
           IsVisible="{Binding IsCave}">
      Basic Height:
    </Label>
    <Button Grid.Column="1"
            Grid.Row="18"
            Content="-"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsCave}"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding DecreaseBasicHeightCommand}"/>
    <TextBox Grid.Column="2"
             Grid.Row="18"
             Height="30"
             HorizontalAlignment="Stretch"
             IsVisible="{Binding IsCave}"
             IsEnabled="{Binding GenerateTerrainButtonEnable}"
             Text="{Binding GenerationParameters.BasicHeight, Converter={StaticResource uInt8ToStringConverter}}">
    </TextBox>
    <Button Grid.Column="3"
            Grid.Row="18"
            Content="+"
            HorizontalAlignment="Center"
            IsVisible="{Binding IsCave}"
            IsEnabled="{Binding GenerateTerrainButtonEnable}"
            Command="{Binding IncreaseBasicHeightCommand}"/>

    <Button x:Name="btnGenerate"
            Grid.Column="0"
            Grid.Row="19"
            HorizontalAlignment="Center"
            Grid.ColumnSpan="4"
            Command="{Binding GenerateTerrainCommand}"
            IsEnabled="{Binding GenerateTerrainButtonEnable}">
      Generate Terrain
    </Button>
  </Grid>
</UserControl>

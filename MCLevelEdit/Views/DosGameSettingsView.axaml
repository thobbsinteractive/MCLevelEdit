<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MCLevelEdit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="240"
             x:Class="MCLevelEdit.Views.DosGameSettingsView"
             x:DataType="vm:DosGameSettingsViewModel">
  <!-- Settings for a game run through DOSBox (Magic Carpet / Hidden Worlds) -->
  <Grid ColumnDefinitions="205,*,50,*,100"
        RowDefinitions="40,40,40,40,40,*">
    <!-- No GroupName: the buttons group by their parent, so each tab keeps its own choice -->
    <RadioButton Margin="1"
                 Grid.Column="0"
                 Grid.Row="0"
                 IsChecked="{Binding !GameIsClassic}"
                 Content="GOG Edition"/>
    <RadioButton Margin="1"
                 Grid.Column="1"
                 Grid.Row="0"
                 IsChecked="{Binding GameIsClassic}"
                 Content="Original"/>
    <Button Grid.Column="4"
            Grid.Row="0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Content="Set Defaults"
            Command="{Binding SetDefaultsCommand}"/>
    <Label Grid.Column="0"
           Grid.Row="1"
           Content="DOS Box EXE:"
           VerticalAlignment="Center"/>
    <TextBox Grid.Column="1"
             Grid.Row="1"
             VerticalAlignment="Center"
             Text="{Binding GameExePath}"/>
    <Label Grid.Column="2"
           Grid.Row="1"
           Content="Args:"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"/>
    <TextBox Grid.Column="3"
             Grid.Row="1"
             VerticalAlignment="Center"
             Text="{Binding GameExeArgs}"/>
    <Button Grid.Column="4"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Content="Select"
            Command="{Binding SelectGameFolderCommand}"/>
    <Label Grid.Column="0"
           Grid.Row="2"
           Content="{Binding LevelsFolderLabel}"
           VerticalAlignment="Center"/>
    <TextBox Grid.Column="1"
             Grid.Row="2"
             Grid.ColumnSpan="3"
             VerticalAlignment="Center"
             Text="{Binding GameLevelsPath}"/>
    <Button Grid.Column="4"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Content="Select"
            Command="{Binding SelectLevelsFolderCommand}"/>
    <Label Grid.Column="0"
           Grid.Row="3"
           Content="{Binding CloudLevelsFolderLabel}"
           IsVisible="{Binding !GameIsClassic}"
           VerticalAlignment="Center"/>
    <TextBox Grid.Column="1"
             Grid.Row="3"
             Grid.ColumnSpan="3"
             VerticalAlignment="Center"
             Text="{Binding GameCloudLevelsPath}"
             IsVisible="{Binding !GameIsClassic}"/>
    <Button Grid.Column="4"
            Grid.Row="3"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Content="Select"
            Command="{Binding SelectCloudLevelsFolderCommand}"
            IsVisible="{Binding !GameIsClassic}"/>
    <Label Grid.Column="0"
           Grid.Row="4"
           Content="Backup Original Levels folder:"
           VerticalAlignment="Center"/>
    <TextBox Grid.Column="1"
             Grid.Row="4"
             Grid.ColumnSpan="3"
             VerticalAlignment="Center"
             Text="{Binding GameLevelsBackupPath}"/>
    <Button Grid.Column="4"
            Grid.Row="4"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Content="Select"
            Command="{Binding SelectBackupLevelsFolderCommand}"/>
  </Grid>
</UserControl>
